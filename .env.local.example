# Copy to .env.local (gitignored) for local development.

# Public Sanity project (same IDs as mllws-sanity Studio). Published
# documents are readable without a token. Never put SANITY_API_WRITE_TOKEN here.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production

# Shared secret for POST /api/revalidate (Sanity webhook query ?secret=).
REVALIDATE_SECRET=

# Deprecated: git-backed MDX fetch. Sanity GROQ replaces this.
# BLOG_CONTENT_TOKEN=

# Feature flags (see flags.js). Connect an Edge Config store to this
# project in the Vercel dashboard (Storage > Edge Config) and Vercel will
# fill this in automatically for Production/Preview/Development. Locally,
# run `vercel env pull` or paste the connection string here.
EDGE_CONFIG=

# Local-only overrides when EDGE_CONFIG is unset. Set to "true" to force a
# flag on without Edge Config. Defaults are false.
# LANGUAGE_HOVER=true
# BECOME_A_MEMBER=true
# DONATE=true
# VOLUNTEER=true
# HEAR_IT_IN_YOUR_LANGUAGE=true

# Public Zeffy (or other) campaign URLs. Used only when the matching flag is
# on and the value is a non-empty https URL; otherwise CTAs stay /contact.
# ZEFFY_MEMBERSHIP_URL=
# ZEFFY_DONATE_URL=
# ZEFFY_VOLUNTEER_URL=

# Used to sign Flags Explorer overrides (Vercel Toolbar) and to authorize
# the app/.well-known/vercel/flags discovery endpoint. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Use a different value per environment.
FLAGS_SECRET=
